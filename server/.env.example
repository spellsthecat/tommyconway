# ── Conway Sales HQ — environment ──────────────────────────────
# Copy this file to ".env" and fill it in, then restart the app.
# NEVER commit your real .env (it's gitignored).

# Port the Node app listens on (Caddy proxies to this)
PORT=3000

# ── AI engine ──────────────────────────────────────────────────
# Pick ONE provider and set its key. Leave blank to run without AI
# (the dashboard still works; AI features stay dormant).

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_MODEL=claude-3-5-sonnet-latest

# --- or use OpenAI instead ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ── Lock the dashboard (strongly recommended — it's a public URL) ─
# If BOTH are set, the whole site asks for this user/password.
# Pick a long random password.
ADMIN_USER=tom
ADMIN_PASS=
